# Telegram
BOT_TOKEN=your_bot_token_here

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/safeout

# Redis
REDIS_URL=redis://localhost:6379/0

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_FROM_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=your_key
SENDGRID_FROM_EMAIL=alert@safeout.app

# S3 / Cloudflare R2 (file storage)
S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_key
S3_SECRET_KEY=your_secret
S3_BUCKET=safeout-files
S3_PUBLIC_URL=https://files.safeout.app

# App
APP_BASE_URL=https://safeout.app
SECRET_KEY=change_me_to_random_string

# Escalation timings (minutes)
PING_INTERVAL_MINUTES=15
ESCALATION_L1_MINUTES=15
ESCALATION_L2_MINUTES=30
